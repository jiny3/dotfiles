{
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
    "agents": {
        "sisyphus": {
            "model": "openai/gpt-5.4",
            "variant": "medium",
            "temperature": 0.1,
            "fallback_models": [
                "github-copilot/gpt-5.2",
                "opencode/big-pickle"
            ]
        },
        "hephaestus": {
            "model": "openai/gpt-5.4",
            "variant": "medium",
            "temperature": 0.1,
            "fallback_models": [
                "github-copilot/gpt-5.2",
                "opencode/big-pickle"
            ]
        },
        "oracle": {
            "model": "github-copilot/gemini-3.1-pro-preview",
            "variant": "high",
            "temperature": 0.1,
            "fallback_models": [
                {
                    "model": "openai/gpt-5.4",
                    "variant": "high"
                }
            ]
        },
        "librarian": {
            "model": "opencode/minimax-m2.5-free",
            "fallback_models": [
                "github-copilot/gemini-3-flash-preview"
            ]
        },
        "explore": {
            "model": "github-copilot/grok-code-fast-1",
            "fallback_models": [
                "opencode/minimax-m2.5-free",
                "opencode/nemotron-3-super-free"
            ]
        },
        "multimodal-looker": {
            "model": "github-copilot/gpt-5.2",
            "fallback_models": [
                "opencode/gpt-5-nano"
            ]
        },
        "prometheus": {
            "model": "openai/gpt-5.4",
            "variant": "high",
            "temperature": 0.1,
            "prompt_append": "Leverage deep & quick agents heavily, always in parallel.",
            "fallback_models": [
                "github-copilot/gemini-3.1-pro-preview"
            ]
        },
        "metis": {
            "model": "openai/gpt-5.4",
            "variant": "high",
            "temperature": 0.3,
            "fallback_models": [
                "github-copilot/gpt-5.2"
            ]
        },
        "momus": {
            "model": "openai/gpt-5.4",
            "variant": "xhigh",
            "temperature": 0.1,
            "fallback_models": [
                "github-copilot/gemini-3.1-pro-preview"
            ]
        },
        "atlas": {
            "model": "openai/gpt-5.4",
            "variant": "medium",
            "temperature": 0.1,
            "fallback_models": [
                "opencode/minimax-m2.5-free"
            ]
        }
    },
    "categories": {
        "quick": {
            "model": "github-copilot/gpt-5.4-mini",
            "temperature": 0.1,
            "fallback_models": [
                "github-copilot/gemini-3-flash-preview",
                "opencode/gpt-5-nano"
            ]
        },
        "deep": {
            "model": "github-copilot/gpt-5.2",
            "variant": "medium",
            "temperature": 0.1,
            "fallback_models": [
                "github-copilot/gemini-3.1-pro-preview"
            ]
        },
        "ultrabrain": {
            "model": "github-copilot/gpt-5.2",
            "variant": "xhigh",
            "temperature": 0.1,
            "fallback_models": [
                {
                    "model": "github-copilot/gemini-3.1-pro-preview",
                    "variant": "high"
                }
            ]
        },
        "artistry": {
            "model": "github-copilot/gemini-3.1-pro-preview",
            "variant": "high",
            "temperature": 0.1,
            "fallback_models": [
                "github-copilot/gpt-5.2"
            ]
        },
        "visual-engineering": {
            "model": "github-copilot/gemini-3.1-pro-preview",
            "variant": "high",
            "temperature": 0.1,
            "fallback_models": [
                "github-copilot/gpt-5.2"
            ]
        },
        "writing": {
            "model": "github-copilot/gemini-3-flash-preview",
            "temperature": 0.2,
            "fallback_models": [
                "opencode/minimax-m2.5-free"
            ]
        },
        "unspecified-low": {
            "model": "openai/gpt-5.4",
            "variant": "medium",
            "temperature": 0.1,
            "fallback_models": [
                "github-copilot/gpt-5.2",
                "opencode/minimax-m2.5-free"
            ]
        },
        "unspecified-high": {
            "model": "openai/gpt-5.4",
            "variant": "high",
            "temperature": 0.1,
            "fallback_models": [
                "anthropic/claude-opus-4-7",
                "github-copilot/gemini-3.1-pro-preview"
            ]
        }
    },
    "background_task": {
        "providerConcurrency": {
            "openai": 3,
            "github-copilot": 8,
            "opencode": 10
        },
        "modelConcurrency": {
            "openai/gpt-5.4": 2,
            "github-copilot/gpt-5.2": 5
        }
    },
    "runtime_fallback": true,
    "_migrations": [
        "model-version:openai/gpt-5.3-codex->openai/gpt-5.4"
    ]
}
