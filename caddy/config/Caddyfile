# Caddy 配置文件
# 反向代理配置：使用子域名访问不同服务
# 使用 mkcert 生成的本地可信任证书
{
	auto_https off
	http_port 8080
	https_port 8443
}

# Vaultwarden - 密码管理器
https://vault.arch {
	tls /certs/arch.pem /certs/arch-key.pem
	encode gzip

	reverse_proxy vaultwarden:80 {
		header_up X-Real-IP {remote_host}
	}
}

# Alist - 文件管理器
https://files.arch {
	tls /certs/arch.pem /certs/arch-key.pem
	encode gzip

	reverse_proxy alist:5244
}

# 主页 - 服务列表
https://arch {
	tls /certs/arch.pem /certs/arch-key.pem

	respond <<HTML
		<!DOCTYPE html>
		<html>
		<head>
			<meta charset="utf-8">
			<title>Services</title>
			<style>
				body { font-family: sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }
				h1 { color: #333; }
				ul { list-style: none; padding: 0; }
				li { margin: 15px 0; }
				a { display: block; padding: 15px; background: #f0f0f0; color: #333; text-decoration: none; border-radius: 5px; }
				a:hover { background: #e0e0e0; }
			</style>
		</head>
		<body>
			<h1>Available Services</h1>
			<ul>
				<li><a href="https://vault.arch">🔐 Vaultwarden - Password Manager</a></li>
				<li><a href="https://files.arch">📁 Alist - File Manager</a></li>
			</ul>
		</body>
		</html>
	HTML 200
}

# HTTP 重定向到 HTTPS
http://vault.arch, http://files.arch, http://arch {
	redir https://{host}{uri} permanent
}
